# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (segredos — nunca commitar)
.env*
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# Playwright MCP — logs/artefactos de teste (não pertencem ao repo)
.playwright-mcp/

# Claude Code — estado local de sessão (lock de tarefas agendadas, definições
# pessoais). Muda a cada sessão e não deve ser partilhado nem gerar commits.
.claude/scheduled_tasks.lock
.claude/settings.local.json
